# Copy this file to `.env` and update values for local development.
# These environment variables override per-lab `config.json` files.

# Filesystem lab
LAB_FILESYSTEM_HOST=192.168.56.101
LAB_FILESYSTEM_USER=learner
LAB_FILESYSTEM_PASSWORD=learner
# Optional: path on the host to a private SSH key for the learner user.
# Example: LAB_FILESYSTEM_SSH_KEY_PATH=C:\Users\you\.ssh\id_rsa
LAB_FILESYSTEM_SSH_KEY_PATH=
